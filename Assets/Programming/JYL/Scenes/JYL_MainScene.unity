  m_text: "\uC120\uC218\uD2C0\uC744 \uBC30\uCE58\uD558\uC5EC \uD6C8\uB828\uC2DC\uD0AC
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB8E8\uD2F4\uC5D0 \uB530\uB77C \uC0C1\uC2B9\uD558\uB294
    \uB2A5\uB825\uCE58\uAC00 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.\n\n<color=#FF3333>\uD6C8\uB828\uC744
    \uC9C4\uD589\uD560 \uB54C 7~12\uC758 \uD53C\uB85C\uB3C4\uAC00 \uC0C1\uC2B9\uD558\uBA70
    1\uD134(1\uC8FC)\uAC00 \uC18C\uBAA8\uB429\uB2C8\uB2E4.</color>"
  m_isRightToLeft: 0
